{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.eco/schemas/legal-card.schema.json",
  "title": "ALMA Legal Core card",
  "type": "object",
  "required": [
    "rule_id",
    "jurisdiction",
    "provision",
    "safe_summary",
    "source_id",
    "official_url",
    "card_hash",
    "review"
  ],
  "properties": {
    "rule_id": {"type": "string", "pattern": "^kz-[a-z0-9-]+$"},
    "jurisdiction": {"const": "KZ"},
    "provision": {"type": "string", "minLength": 1},
    "safe_summary": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "official_url": {
      "type": "string",
      "pattern": "^https://(www\\.)?adilet\\.zan\\.kz/"
    },
    "card_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "editorial_comment": {"type": ["string", "null"]},
    "source_sheet_row": {"type": "integer", "minimum": 6},
    "review": {
      "type": "object",
      "required": [
        "owner_status",
        "pilot_status",
        "legal_editor_status",
        "independent_lawyer_status",
        "public_release_status",
        "source_change_status",
        "source_checked_at"
      ],
      "properties": {
        "owner_status": {"enum": ["OWNER_ACCEPTED", "OWNER_REVIEW_REQUIRED"]},
        "pilot_status": {"enum": ["PILOT_ELIGIBLE", "PILOT_BLOCKED"]},
        "legal_editor_status": {
          "enum": ["AUTHOR_LEGAL_REVIEW_APPROVED", "LEGAL_EDITOR_REVIEW_REQUIRED"]
        },
        "independent_lawyer_status": {
          "enum": [
            "INDEPENDENT_LAWYER_REVIEW_PENDING",
            "INDEPENDENT_LAWYER_REVIEW_APPROVED"
          ]
        },
        "public_release_status": {
          "enum": ["PUBLIC_LEGAL_RELEASE_BLOCKED", "PUBLIC_LEGAL_RELEASE_APPROVED"]
        },
        "source_change_status": {
          "enum": ["MANUAL_BASELINE_ONLY", "UNCHANGED", "SOURCE_CHANGED_UNREVIEWED"]
        },
        "sheet_status": {"type": "string"},
        "review_view_version": {"type": "string"},
        "source_checked_at": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
