# Use this file only for a local test. Do not commit real values.
MERGIN_USER=
MERGIN_PASS=
SMTP_USER=
SMTP_PASS=
GEMINI_API_KEY=
STATE_BUCKET=

# SMTP2GO transport. The visible sender is intentionally not the login name.
MAIL_FROM=monitor@alma.eco
MAIL_FROM_NAME=ALMA Monitor
SMTP_HOST=mail-eu.smtp2go.com
SMTP_PORT=587

# Optional. The code has stable fallback models.
GEMINI_MODEL=gemini-3.6-flash
LOG_LEVEL=INFO

# Keep the public mode blocked until both exact legal reviews are committed.
ALMA_RELEASE_MODE=controlled_pilot
